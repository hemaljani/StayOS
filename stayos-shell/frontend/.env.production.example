# StayOS shell build-time configuration (NEXT_PUBLIC_* is inlined into the static
# export). The shell authenticates against the shared StayOS (LUMI) Cognito user
# pool - use the SAME client ID and region as LUMI and PULSE so the issued
# session is valid across all three apps.
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=us-east-1
