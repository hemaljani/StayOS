# Makefile - StayOS Shell Build & Deploy
#
# Static assets served from the distribution ROOT ("/") of the shared StayOS
# bucket + CloudFront owned by LUMI (LUMI at /lumi/, PULSE at /pulse/). The shell
# has no infra of its own: this generates its Cognito config from LUMI stack
# outputs, builds the static export, syncs it to the bucket root, invalidates root.
#
# Prerequisites: AWS CLI v2, Node.js 18+. Run after LUMI's stack exists (reads
# LUMI's Cognito + bucket + distribution).
#
# Usage:
#   make deploy                          # uses current AWS profile account
#   make deploy ACCOUNT_ID=123456789012  # explicit account

STACK_PREFIX ?= stayos
PROFILE ?=
ifeq ($(strip $(PROFILE)),)
PROFILE := $(AWS_PROFILE)
endif
ifeq ($(strip $(PROFILE)),)
unexport AWS_PROFILE
else
override AWS_PROFILE := $(PROFILE)
export AWS_PROFILE
endif
ENVIRONMENT ?= test
EXPECTED_ACCOUNT_ID ?=
REGION ?= us-east-1
ORCHESTRATED ?= 0
step = $(if $(filter 1,$(ORCHESTRATED)),  - $(2),[$(1)] $(2))
AWS_REGION := $(REGION)
AWS_DEFAULT_REGION := $(REGION)
export AWS_REGION AWS_DEFAULT_REGION
AWS_PROFILE_FLAG := $(if $(PROFILE),--profile $(PROFILE),)
ACCOUNT_ID ?= $(shell aws $(AWS_PROFILE_FLAG) --region $(REGION) sts get-caller-identity --query Account --output text 2>/dev/null)
STACK_NAME := $(STACK_PREFIX)-$(REGION)
FRONTEND_BUCKET := $(STACK_PREFIX)-frontend-$(ACCOUNT_ID)

.PHONY: all assert-account deploy write-frontend-env build-frontend deploy-frontend \
        invalidate-cdn test test-frontend lint clean destroy

all: deploy

# Full shell deploy: config -> build -> sync to root -> invalidate "/".
assert-account:
	@if [ -z "$(ACCOUNT_ID)" ]; then \
		echo "ERROR: unable to resolve the active AWS account."; exit 1; \
	fi
	@if [ -n "$(EXPECTED_ACCOUNT_ID)" ] && [ "$(ACCOUNT_ID)" != "$(EXPECTED_ACCOUNT_ID)" ]; then \
		echo "ERROR: AWS account mismatch (expected $(EXPECTED_ACCOUNT_ID), resolved $(ACCOUNT_ID))."; \
		exit 1; \
	fi

deploy: assert-account write-frontend-env build-frontend deploy-frontend invalidate-cdn
	@if [ "$(ORCHESTRATED)" != "1" ]; then \
		echo ""; \
		echo "StayOS shell deployment complete at the distribution root."; \
	fi

# ─── Step 1: Generate frontend config from the LUMI stack outputs ─────────────
# Shares LUMI/PULSE's Cognito pool + app client (SSO across all three). Pull the
# client ID from the shared stack; region is the deploy region.
write-frontend-env:
	@echo "$(call step,1/4,Generating shell config from stack outputs...)"
	@CLIENT_ID=$$(aws cloudformation describe-stacks \
		--stack-name $(STACK_NAME) \
		--query "Stacks[0].Outputs[?OutputKey=='UserPoolClientId'].OutputValue" \
		--output text) && \
	if [ -z "$$CLIENT_ID" ] || [ "$$CLIENT_ID" = "None" ]; then \
		echo "ERROR: required UserPoolClientId was not resolved from $(STACK_NAME)."; exit 1; \
	fi && \
	printf '%s\n' \
		"# Auto-generated by make deploy - do not edit manually" \
		"NEXT_PUBLIC_COGNITO_CLIENT_ID=$$CLIENT_ID" \
		"NEXT_PUBLIC_COGNITO_REGION=$(REGION)" \
		> frontend/.env.production
	@echo "    done"

# ─── Step 2: Build the static export ──────────────────────────────────────────
build-frontend:
	@echo "$(call step,2/4,Building shell frontend...)"
	@cd frontend && npm ci --legacy-peer-deps && npm run build
	@echo "    done"

# ─── Step 3: Deploy to the bucket ROOT ────────────────────────────────────────
# The shell owns the site root. NOTE: no --delete - a blanket root delete would
# wipe the /lumi/ and /pulse/ assets. Shell files are overwritten in place.
deploy-frontend:
	@echo "$(call step,3/4,Deploying shell to S3 (bucket root)...)"
	@aws s3 sync frontend/out/ s3://$(FRONTEND_BUCKET)/ --exclude "lumi/*" --exclude "pulse/*" --quiet
	@echo "    done"

# ─── Step 4: Invalidate the root cache entries ────────────────────────────────
# Invalidate the shell's entry points only (root + top-level files), not /lumi/*
# or /pulse/*, so a shell redeploy does not churn the feature caches.
invalidate-cdn:
	@echo "$(call step,4/4,Invalidating CDN cache (shell root)...)"
	@aws cloudfront create-invalidation \
		--distribution-id $$(aws cloudformation describe-stacks \
			--stack-name $(STACK_NAME) \
			--query "Stacks[0].Outputs[?OutputKey=='FrontendDistributionId'].OutputValue" \
			--output text) \
		--paths "/" "/index.html" "/_next/*" "/favicon.svg" "/logo.svg" > /dev/null
	@echo "    done"

# ─── Testing / lint ───────────────────────────────────────────────────────────
test: test-frontend
	@echo "All tests passed"

test-frontend:
	@echo "Running shell frontend tests..."
	@cd frontend && npm run test:run

lint:
	@echo "Linting shell frontend..."
	@cd frontend && npm run lint

clean:
	@rm -rf frontend/.next frontend/out

# ─── Teardown ─────────────────────────────────────────────────
# The shell has NO infra of its own - just static files at the distribution
# ROOT. "destroy" removes only the shell's root-level objects, WITHOUT touching
# /lumi/* or /pulse/* (mirrors deploy-frontend's exclusion set), then invalidates
# the root cache. Largely redundant in a full teardown (LUMI's destroy empties
# the whole bucket) but useful for a standalone "unpublish the shell".
#
# WARNING: Removes the live shell (login + launcher) from the shared origin.
#
# Usage:
#   make destroy   # unpublish the shell from the shared bucket root
destroy: assert-account
	@echo "  [shell] Removing shell root objects from s3://$(FRONTEND_BUCKET)/ (excluding /lumi/*, /pulse/*)..."
	@aws s3 rm s3://$(FRONTEND_BUCKET)/ --recursive \
		--exclude "lumi/*" --exclude "pulse/*" --quiet 2>/dev/null || true
	@echo "  [shell] Invalidating CDN cache (shell root)..."
	@DIST_ID=$$(aws cloudformation describe-stacks \
		--stack-name $(STACK_NAME) \
		--query "Stacks[0].Outputs[?OutputKey=='FrontendDistributionId'].OutputValue" \
		--output text 2>/dev/null); \
	if [ -n "$$DIST_ID" ] && [ "$$DIST_ID" != "None" ]; then \
		aws cloudfront create-invalidation --distribution-id "$$DIST_ID" --paths "/" "/index.html" > /dev/null 2>&1 || true; \
		echo "  [shell] CDN invalidation requested"; \
	else \
		echo "  [shell] No distribution found (LUMI stack may already be gone) - skipping invalidation"; \
	fi
	@echo "  [shell] Shell teardown complete."
