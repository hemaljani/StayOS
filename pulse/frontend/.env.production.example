# PULSE frontend environment variables for production deployment.
# Copy this file to .env.production and fill in your values.
# PULSE reuses the existing LUMI Amazon Cognito user pool (Requirement 16.1).
NEXT_PUBLIC_API_URL=https://<your-api-gateway-id>.execute-api.<region>.amazonaws.com/v1
NEXT_PUBLIC_COGNITO_CLIENT_ID=<your-cognito-client-id>
NEXT_PUBLIC_COGNITO_REGION=<region>
NEXT_PUBLIC_AWS_REGION=<region>
# The following are consumed in a later batch (Task 21.3, AppSync Events realtime
# + Web Push). They are fetched at runtime from GET /config/realtime and
# GET /config/vapid-public-key, so no build-time value is required here.
